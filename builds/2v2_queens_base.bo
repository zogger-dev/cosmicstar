# 2v2 baseline: gasless 15 hatch / 15 overlord / 15 pool with a double
# extractor trick, then 4 queens. No gas or roaches: used to measure larva and
# inject timings before planning the roach timing (see 2v2_roach.bo).
14 extractor_trick        # 14/14 -> 15/14
15 hatch natural          # drone pulled on a timer to arrive as the bank reaches 275 (-> 14/14)
-  default main           # main to 16, then a 3rd drone on the far patches
14 extractor_trick        # 14/14 -> 15/14 again
15 overlord
15 pool
@natural_soon transfer 4 main natural   # the 4 stacked drones arrive as the natural finishes
-  default fill           # from here: natural, then third, 16 mineral drones each
@pool queen main
@natural queen natural
26 overlord main          # double overlord from the main: 4 queens need the supply
27 overlord main
@queen:main queen main    # second pair of queens as soon as the first pair pops
@queen:natural queen natural
-  auto_overlords
